#!/usr/bin/env bash

SRC=.

parse() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
    -h | --help) FLAG_HELP=1; shift ;;
    --with-src) SRC='./src'; shift ;;
    --no-git) FLAG_NO_GIT=1; shift ;;
    --) shift; ARGS="$ARGS $@"; break ;;
    *) ARGS="$ARGS $1"; shift ;;
    esac
  done
}
parse "$@"
set -- $ARGS

if [ "$FLAG_HELP" == "1" ]; then
  echo 'usage: command [--with-src] [--no-git] [project]'
  exit
fi

PJ=${1:-app}
SED=$(which gsed >/dev/null && echo gsed || echo sed)
set -e

# create a project
mkdir -p "${PJ}"
cd "${PJ}"

test -e package.json && {
  echo 'Project already exists.'
  exit 1
}

# nodejs setup
npm init -y

${SED} -i -f <(cat <<EOF
s:index.js:./dist/index.js:
/"scripts":/ {
  a\    "start": "node ./dist",
  a\    "dev": "NODE_ENV=development npx nodemon --watch ${SRC} --ext ts --exec 'npx tsc --noEmit && npx tsx ${SRC}/index.ts'",
}
EOF
) package.json

# typescript@7. ts-node needs ts.sys, which v7 removed, so dev typechecks with tsc and runs with tsx.
npm i -D typescript@7 @types/node tsx tsc-alias nodemon jsonc-parser

# tsconfig setup
npx tsc --init --outDir ./dist --incremental true --resolveJsonModule true

# Patch JSONC in place (keep `tsc --init` comments). Sed cannot add paths when the template omits "paths".
# Do not set baseUrl or moduleResolution=node10: TypeScript 7 removed both.
TSAPP_SRC="${SRC}" node <<'NODE'
const fs = require('fs');
const jsonc = require('jsonc-parser');
const src = process.env.TSAPP_SRC;
const p = 'tsconfig.json';
let text = fs.readFileSync(p, 'utf8');
const opts = { formattingOptions: { insertSpaces: true, tabSize: 2 } };
for (const [path, value] of [
  [['compilerOptions', 'rootDir'], src],
  [['compilerOptions', 'tsBuildInfoFile'], './dist/tsconfig.tsbuildinfo'],
  [['compilerOptions', 'module'], 'commonjs'],
  [['compilerOptions', 'moduleResolution'], 'bundler'],
  [['compilerOptions', 'verbatimModuleSyntax'], false],
  [['compilerOptions', 'types'], ['node']],
  [['compilerOptions', 'paths'], { '@/*': [`${src}/*`] }]]) {
  text = jsonc.applyEdits(text, jsonc.modify(text, path, value, opts));
}
fs.writeFileSync(p, text);
NODE

# builder
cat <<'EOF' > Makefile
build:
	npx tsc
	npx tsc-alias

watch:
	npx tsc -w & \
	npx nodemon --watch dist/**/* --exec 'npx tsc-alias' & \
	wait
EOF

# versioning
touch .gitignore
echo /node_modules >> .gitignore
echo /dist >> .gitignore
if [ "$FLAG_NO_GIT" != "1" ]; then
  git init && git add . && git commit -m 'first commit'
fi

# test
mkdir -p "${SRC}"

echo "import { module } from '@/module';
module();" > "${SRC}/index.ts"

echo "export function module() {
  console.log('happy hacking!');
}" > "${SRC}/module.ts"

make
npm start
